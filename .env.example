# 複製成 .env 後填寫：cp .env.example .env

# ── Telegram ──────────────────────────────────────────────
# 跟 @BotFather 申請的 bot token
TELEGRAM_BOT_TOKEN=
# 開了「主題 (Topics)」的 Telegram 群組 ID（-100 開頭）。
# 先留空也可以：啟動後在群組裡隨便講一句話，bot 會回覆群組 ID 和你的使用者 ID。
TELEGRAM_CHAT_ID=
# 你自己的 Telegram 使用者 ID，只有這個人傳的訊息會被轉發出去
TELEGRAM_OWNER_ID=

# ── 本機 Matrix ───────────────────────────────────────────
# 只在本機用的假網域，不需要真的註冊
SERVER_NAME=home.local
# 你在本機 Matrix 的帳號（之後登入 FB/IG/LINE 都綁在這個帳號上）
MATRIX_USER=me
# 請改成一組夠長的隨機密碼（只用英文字母和數字，避免 $ ! 等符號被 shell 解讀）
MATRIX_PASSWORD=change-me-to-a-long-random-password

# ── 要啟用哪些平台（逗號分隔，可選 fb,ig,line,discord）─────────────────
# docker compose 和 relay 共用這個設定，沒列到的平台不會啟動
# 想加 LINE 或 Discord 就改成例如 fb,ig,line,discord 再執行一次 ./setup.sh
COMPOSE_PROFILES=fb,ig

# ── 只轉發白名單聊天的平台（逗號分隔，留空 = 全部直接轉發）──────────
# 這些平台只會轉發你在「🤖 … 登入 / 管理」主題用 /chats 加入的聊天
# 預設只有 LINE（官方帳號、廣告帳號很多）
APPROVE_NEW_CHATS=line

# ── 訊息請求先不轉發（逗號分隔，留空 = 照常轉發）────────────────
# IG 會把「你沒追蹤的人」傳來的私訊放進「訊息請求」。這些平台的訊息請求先默默存著，
# 在 App 裡接受請求後才開始轉，接受前收到的最近 20 則會補送。FB 也有訊息請求，想一起擋就改成 ig,fb
HOLD_MESSAGE_REQUESTS=ig

# ── 每日登入檢查 ────────────────────────────────────────────
# 每天這個時間（台灣時間）檢查各平台登入狀態，結果發到 General；留空就不檢查
# 隨時也可以在 General 輸入 /status 手動檢查
LOGIN_CHECK_TIME=09:00

# ── 只在通知時段收訊息 ──────────────────────────────────────────
# 這段時間（台灣時間）以外收到的訊息先存著不送（完全不跳通知），通知時段一到再補送
# 留空 = 隨時都送。登入 / 管理主題和系統警告不受影響
# NOTIFY_HOURS 例如 08:00-22:00（晚上不吵），也可以跨夜，例如 22:00-06:00
# NOTIFY_DAYS 是星期幾（1 = 週一 … 7 = 週日），例如 1-5 或 1,3,5；留空 = 每天
NOTIFY_HOURS=
NOTIFY_DAYS=
# 通知時段開始前幾分鐘就先把累積的訊息補送進來（靜音送達），時段一開始就不用等補送；0 = 通知時段到了才補送
PRELOAD_MINUTES=60

# ── 群組成員防護 ────────────────────────────────────────────
# 群組裡超過這個人數（你和 bot = 2）就暫停轉發，新訊息先存著，人數恢復後自動補送
GROUP_MAX_MEMBERS=2
